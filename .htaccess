# cv.deweb.studio — LH.pl (Apache)
RewriteEngine On
RewriteRule ^cv\.pdf$ Andrii-Deleniv-CV.pdf [L]
RewriteRule ^pdf$ Andrii-Deleniv-CV.pdf [L]
RewriteRule ^wp-seo\.pdf$ Andrii-Deleniv-CV-WordPress-SEO.pdf [L]
<FilesMatch "\.pdf$">
  ForceType application/pdf
  Header set Content-Disposition "attachment"
</FilesMatch>
