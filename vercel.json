{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/cv.pdf",
      "destination": "/Andrii-Deleniv-CV.pdf"
    },
    {
      "source": "/pdf",
      "destination": "/Andrii-Deleniv-CV.pdf"
    },
    {
      "source": "/wp-seo.pdf",
      "destination": "/Andrii-Deleniv-CV-WordPress-SEO.pdf"
    }
  ],
  "headers": [
    {
      "source": "/(.*\\.pdf|pdf)",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment"
        },
        {
          "key": "Content-Type",
          "value": "application/pdf"
        }
      ]
    }
  ]
}