{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/cv.pdf", "destination": "/Andrii-Deleniv-CV.pdf" },
    { "source": "/pdf", "destination": "/Andrii-Deleniv-CV.pdf" }
  ],
  "headers": [
    {
      "source": "/(Andrii-Deleniv-CV.pdf|cv.pdf|pdf)",
      "headers": [
        { "key": "Content-Disposition", "value": "attachment; filename=\"Andrii-Deleniv-CV.pdf\"" },
        { "key": "Content-Type", "value": "application/pdf" }
      ]
    }
  ]
}
